{
	"Yore Card": {
		"scope": "markdown",
		"prefix": "yore-card",
		"body": [
			"{{< card",
			"  title=\"${1:Title}\"",
			"  href=\"${2:https://example.com}\"",
			"  desc=\"${3:Description.}\"",
			"  image=\"${4:/img/01.webp}\"",
			">}}"
		],
		"description": "General-purpose preview card with title, description, optional image or icon, and metadata."
	},

	"Yore Article Card": {
		"scope": "markdown",
		"prefix": "yore-article",
		"body": [
			"{{< article path=\"${1:/docs/40-getting-started}\" desc=${2|true,false|} meta=${3|true,false|} >}}"
		],
		"description": "Visual preview card for an internal page. path is required."
	},

	"Yore GitHub Card": {
		"scope": "markdown",
		"prefix": "yore-github",
		"body": [
			"{{< github repo=\"${1:owner/repo}\" >}}"
		],
		"description": "Dynamic preview card for a GitHub repository. repo format is owner/repo."
	},

	"Yore Email": {
		"scope": "markdown",
		"prefix": "yore-email",
		"body": [
			"{{< email address=\"${1:hello@example.com}\" >}}"
		],
		"description": "Obfuscates an email address using base64 encoding, decoded client-side into a mailto link."
	},

	"Yore Embed Code": {
		"scope": "markdown",
		"prefix": "yore-embed-code",
		"body": [
			"{{< embed-code url=\"${1:https://raw.githubusercontent.com/user/repo/refs/heads/main/path/to/file}\" type=\"${2:java}\" lines=\"${3:3-7}\" >}}"
		],
		"description": "Fetches source code from a remote URL and renders it as a highlighted code block."
	},

	"Yore Embed Markdown (remote)": {
		"scope": "markdown",
		"prefix": "yore-embed-md-url",
		"body": [
			"{{% embed-md url=\"${1:https://example.com/path/to/file.md}\" %}}"
		],
		"description": "Fetches and renders remote Markdown content. Must use markdown notation."
	},

	"Yore Embed Markdown (internal page)": {
		"scope": "markdown",
		"prefix": "yore-embed-md-path",
		"body": [
			"{{% embed-md path=\"${1:/docs/shortcodes/40-math/index.md}\" %}}"
		],
		"description": "Renders Markdown content from an internal page. Must use markdown notation."
	},

	"Yore Fig": {
		"scope": "markdown",
		"prefix": "yore-fig",
		"body": [
			"{{% fig attrs=\"${1:class='center-cap center-img'}\" src=\"${2:/img/04.webp}\" alt=\"${3:alt}\" caption=\"${4:Caption text}\" %}}"
		],
		"description": "Renders an image inside a figure element with a figcaption that supports footnotes. Must use markdown notation."
	},

	"Yore Float": {
		"scope": "markdown",
		"prefix": "yore-float",
		"body": [
			"{{% float side=\"${1|start,end|}\" size=\"${2|s,m,l|}\" %}}",
			"",
			"${3:Content here.}",
			"",
			"{{% /float %}}"
		],
		"description": "Floats arbitrary content left or right with text wrapping."
	},

	"Yore Cols": {
		"scope": "markdown",
		"prefix": "yore-cols",
		"body": [
			"{{% cols widths=\"${1:70%,30%}\" rwd=${2|true,false|} %}}",
			"",
			"${3:Column one content.}",
			"",
			"<!-- cell -->",
			"",
			"${4:Column two content.}",
			"",
			"{{% /cols %}}"
		],
		"description": "Flexible multi-column layout. Must use markdown notation."
	},

	"Yore Carousel": {
		"scope": "markdown",
		"prefix": "yore-carousel",
		"body": [
			"{{< carousel ratio=\"${1:4/3}\" fit=\"${2|contain,cover|}\" thumbs=${3|true,false|} arrows=${4|true,false|} counter=${5|true,false|} >}}",
			"",
			"- src: ${6:/img/01.webp}",
			"  caption: ${7:Caption text}",
			"  alt: ${8:Alt text}",
			"",
			"{{< /carousel >}}"
		],
		"description": "Image carousel with viewport, navigation, and thumbnail strip. Inner content is YAML."
	},

	"Yore Carousel (match glob)": {
		"scope": "markdown",
		"prefix": "yore-carousel-match",
		"body": [
			"{{< carousel ratio=\"${1:4/3}\" >}}",
			"",
			"- match: ${2:/img/[0-9]*}",
			"",
			"{{< /carousel >}}"
		],
		"description": "Image carousel batch-loading images with a glob pattern."
	},

	"Yore Masonry": {
		"scope": "markdown",
		"prefix": "yore-masonry",
		"body": [
			"{{< masonry maxCols=\"${1:3}\" >}}",
			"",
			"- src: ${2:/img/02.webp}",
			"  alt: ${3:Alt text}",
			"  caption: ${4:Caption text}",
			"",
			"{{< /masonry >}}"
		],
		"description": "Fluid masonry-style image wall. Inner content is YAML."
	},

	"Yore Masonry (match glob)": {
		"scope": "markdown",
		"prefix": "yore-masonry-match",
		"body": [
			"{{< masonry maxCols=\"${1:3}\" >}}",
			"",
			"- match: ${2:/img/[0-9]*}",
			"",
			"{{< /masonry >}}"
		],
		"description": "Image masonry batch-loading images with a glob pattern."
	},


	"Yore Icon": {
		"scope": "markdown",
		"prefix": "yore-icon",
		"body": [
			"{{< icon \"${1:github}\" >}}"
		],
		"description": "Renders an inline SVG icon from the theme's icon library."
	},

	"Yore Audio": {
		"scope": "markdown",
		"prefix": "yore-audio",
		"body": [
			"{{< audio",
			"  src=\"${1:/audio/beep.mp3}\"",
			"  caption=\"${2:Caption}\"",
			"  loop=${3|true,false|}",
			">}}"
		],
		"description": "Embeds a HTML5 audio player. src is required."
	},

	"Yore Video": {
		"scope": "markdown",
		"prefix": "yore-video",
		"body": [
			"{{< video",
			"  src=\"${1:/video/clip.webm}\"",
			"  caption=\"${2:Caption}\"",
			"  loop=${3|true,false|}",
			"  muted=${4|true,false|}",
			">}}"
		],
		"description": "Embeds a HTML5 video player. src is required."
	},

	"Yore PDF": {
		"scope": "markdown",
		"prefix": "yore-pdf",
		"body": [
			"{{< pdf src=\"${1:/docs/file.pdf}\" page=\"${2:1}\" height=\"${3:800px}\" >}}"
		],
		"description": "Embeds a PDF file using an inline iframe viewer. src is required."
	},

	"Yore YouTube": {
		"scope": "markdown",
		"prefix": "yore-youtube",
		"body": [
			"{{< youtube id=\"${1:ldX1Ii0MofQ}\" params=\"${2:start=30}\" >}}"
		],
		"description": "Embeds an optimized YouTube video player."
	},

	"Yore TypeIt": {
		"scope": "markdown",
		"prefix": "yore-typeit",
		"body": [
			"{{< typeit speed=\"${1:50}\" loop=\"${2|true,false|}\" tag=\"${3:h2}\" >}}",
			"${4:Typed text here}",
			"{{< /typeit >}}"
		],
		"description": "Dynamic typewriter animation shortcode."
	}
}
